<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:cw.MauiExtensions.Services.Demo.ViewModels"
             x:DataType="vm:ModalViewModel"
             x:Class="MauiExtensions.Demo.Views.ModalPage"
             Title="Modal page"
             Background="{AppThemeBinding Light={StaticResource PageBackground}, Dark={StaticResource PageBackgroundDark}}">
  <VerticalStackLayout Spacing="25">
    <VerticalStackLayout.Padding>
      <OnPlatform x:TypeArguments="Thickness" Default="18,6,18,0">
        <On Platform="iOS" Value="18,0,18,0" />
        <On Platform="Android" Value="18,0,18,0" />
      </OnPlatform>
    </VerticalStackLayout.Padding>
    <Button Text="X"
            Command="{Binding CloseModalCommand}"/>
    <Button Text="Toggle color"
            Clicked="OnToggleBttnClicked"/>
    <Label Text="This is a modal page."
           FontSize="Medium"/>
    <Label Text="Tap X to close, tap 'Toggle color' to switch between a solid background color and a gradient color."
           FontSize="Medium"/>
  </VerticalStackLayout>
</ContentPage>